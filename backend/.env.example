# ==============================================================================
# IMS Backend Environment Variables
# ==============================================================================

# Server Port
PORT=5000

# JWT Authentication
JWT_SECRET=dev-secret-key
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# Database Connection (MySQL / Cloud Database)
# ------------------------------------------------------------------------------
# Option A: Individual Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ims_db
DB_PORT=3306
DB_SSL=false

# Option B: Single Connection URI
# MYSQL_URL=mysql://username:password@hostname:3306/dbname

# ------------------------------------------------------------------------------
# Database Keep-Alive Settings (Optional)
# ------------------------------------------------------------------------------
# Background Heartbeat Ping Interval in seconds (default: 600 = 10 minutes)
DB_KEEP_ALIVE_INTERVAL=600
